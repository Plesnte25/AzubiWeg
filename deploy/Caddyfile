(app) {
	# Compresses both the static client bundle (JS/CSS under /assets/*) and
	# proxied API JSON responses. Placed at the Caddy layer rather than as
	# Express `compression` middleware because Caddy serves the static files
	# directly (file_server below) — an Express-only fix would miss the
	# larger of the two wins. Declared inside each handle block (not once at
	# the top level) since encode only reliably applies to the block it's
	# matched into.
	handle /api/* {
		encode zstd gzip
		reverse_proxy localhost:3000
	}

	handle {
		encode zstd gzip
		root * /opt/azubiweg/client-dist
		# Vite content-hashes everything under /assets/* (filename changes on
		# every rebuild), so it's safe to cache those forever.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# icons.svg/favicon.svg aren't hashed — cache them, but not forever, so
		# a future swap doesn't stay stale for a year on return visits. Fonts
		# used to live here too, unhashed under /fonts/*; they're now imported
		# through Vite (src/assets/fonts/) and content-hashed into /assets/*
		# above instead, so there's nothing left to serve at /fonts/*.
		@staticmedia path /icons.svg /favicon.svg
		header @staticmedia Cache-Control "public, max-age=604800"
		try_files {path} /index.html
		file_server
	}
}

azubiweg.duckdns.org {
	import app
}

# Uncomment once the eu.org application for azubiweg.eu.org is approved and
# its A record is live — Caddy will fetch a separate Let's Encrypt cert for
# it automatically, no other change needed. Leave commented until then: an
# unresolvable domain block makes Caddy retry/log ACME failures continuously.
# azubiweg.eu.org {
# 	import app
# }

# Permanent plain-HTTP mirror on the raw IP, for domain reviewers (eu.org's
# manual review, or anyone else) to verify reachability before a given DNS
# record exists. Deliberately kept indefinitely (not a one-off toggle) — a
# prior temporary version of this broke the moment it was reverted, which is
# exactly why the is-a.dev PR got closed as "unreachable" when reviewed
# later. Explicit http:// scheme disables Caddy's automatic-HTTPS for this
# block only; the real domains above still get proper Let's Encrypt certs
# once their DNS goes live.
#
# 2026-09-07: migrating from GCP (34.42.175.158) to Oracle
# (80.225.236.36) — this same pattern doubles as a way to verify the new
# box end-to-end before switching azubiweg.duckdns.org's DNS over. Remove
# the GCP block once cutover is confirmed and that instance is decommissioned.
http://34.42.175.158 {
	import app
}

http://80.225.236.36 {
	import app
}
