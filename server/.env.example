DATABASE_URL="postgresql://companion:companion@localhost:5433/companion"
JWT_SECRET="generate-a-long-random-string"
PORT=3000

# Temporary public demo mode, for external site-analysis tools (PageSpeed
# Insights, GTmetrix) that crawl unauthenticated — see docs/DEPLOYMENT.md.
# Leave unset/false in normal operation. When true, POST /api/auth/demo-login
# hands out a real, short-lived token for the seeded demo account (run
# `npm run seed:demo` once) with no login required.
# DEMO_MODE_ENABLED=true
# DEMO_USER_EMAIL="demo@azubiweg.internal"
# DEMO_TOKEN_EXPIRES_IN="24h"

# Optional PONS Dictionary API diagnostic (services/enrichment/pons.ts).
# Leave unset in normal operation -- the module is a true no-op without it.
# When set, adding a word that's ambiguous or an inflected-form hop prints a
# sanitized suggestion line to the server log only (e.g. "[PONS diagnostic
# for Schloss: castle / lock]"). It never influences what gets published --
# no sense selection, no curation/reviewNote, nothing written to a Word row
# or the vault -- see pons.ts's doc comment for why (PONS's Terms of Use
# don't permit persisting/extending output from it). Free signup at
# https://en.pons.com/p/online-dictionary/developers/api, 1000 requests/month.
# PONS_API_KEY="your-pons-secret"
