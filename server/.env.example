DATABASE_URL="postgresql://companion:companion@localhost:5433/companion"
JWT_SECRET="generate-a-long-random-string"
PORT=3000

# Temporary public demo mode, for external site-analysis tools (PageSpeed
# Insights, GTmetrix) that crawl unauthenticated — see docs/DEPLOYMENT.md.
# Leave unset/false in normal operation. When true, POST /api/auth/demo-login
# hands out a real, short-lived token for the seeded demo account (run
# `npm run seed:demo` once) with no login required.
# DEMO_MODE_ENABLED=true
# DEMO_USER_EMAIL="demo@azubiweg.internal"
# DEMO_TOKEN_EXPIRES_IN="24h"
